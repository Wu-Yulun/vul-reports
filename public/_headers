# Astro emits hashed, immutable asset names under /_astro/, so they can be
# cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# A prerendered file takes its type from its extension, which drops the charset;
# feeds in particular must declare UTF-8 for non-ASCII titles.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/zh-CN/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  locale?: 'en' | 'zh-CN';
  /** Home page of the current locale. */
  home: string;
  /**
   * Link to the counterpart page in the other locale, or `null` when no
   * translation exists. Reports are written in pairs, but the pair is not
   * guaranteed: a report may exist in only one language.
   */
  alternate: { locale: 'en' | 'zh-CN'; label: string; href: string } | null;
}

const { title, description = 'Vulnerability reports.', locale = 'en', home, alternate } = Astro.props;

const siteTitle = locale === 'zh-CN' ? '首页' : 'Home';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={withBase('/logo.svg')} type="image/svg+xml" />
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@700&family=Noto+Serif+SC:wght@400;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
    />

    {alternate && <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />}
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="site-title" href={home}>
          <svg
            class="site-title-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
            <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          </svg>
          {siteTitle}
        </a>
        {alternate && <a class="locale-link" href={alternate.href}>{alternate.label}</a>}
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

---
import '../styles/global.css';
import { absoluteFromHref, absoluteUrl, withBase } from '../lib/url';
import { siteName } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  locale?: 'en' | 'zh-CN';
  /** App-relative path of this page, e.g. `/20261024/free-fs/`. */
  path: string;
  /** Home page of the current locale. */
  home: string;
  /**
   * Link to the counterpart page in the other locale, or `null` when no
   * translation exists. Reports are written in pairs, but the pair is not
   * guaranteed: a report may exist in only one language.
   */
  alternate: { locale: 'en' | 'zh-CN'; label: string; href: string } | null;
  /** `article` for a report, `website` for a list page. */
  type?: 'website' | 'article';
  /** ISO date, for reports. */
  published?: string;
  /** Structured data; `url` is filled in when missing. */
  jsonLd?: Record<string, unknown>;
  /** Keep a page out of search results. */
  noindex?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  path,
  home,
  alternate,
  type = 'website',
  published,
  jsonLd,
  noindex = false,
} = Astro.props;

const siteTitle = locale === 'zh-CN' ? '首页' : 'Home';

const canonical = absoluteUrl(path);
const alternateUrl = alternate ? absoluteFromHref(alternate.href) : null;

// Every translation known to exist, including this page itself.
const english = locale === 'en' ? canonical : alternate?.locale === 'en' ? alternateUrl : null;
const chinese = locale === 'zh-CN' ? canonical : alternate?.locale === 'zh-CN' ? alternateUrl : null;
const xDefault = english ?? chinese ?? canonical;

const structuredData = jsonLd
  ? { '@context': 'https://schema.org', url: canonical, ...jsonLd }
  : null;
// `</script>` inside a JSON string would end the block early.
const structuredJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={withBase('/logo.svg')} type="image/svg+xml" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    {english && <link rel="alternate" hreflang="en" href={english} />}
    {chinese && <link rel="alternate" hreflang="zh-CN" href={chinese} />}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName('en')}
      href={withBase('/rss.xml')}
    />

    <meta property="og:site_name" content={siteName(locale)} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    {alternate && (
      <meta
        property="og:locale:alternate"
        content={alternate.locale === 'zh-CN' ? 'zh_CN' : 'en_US'}
      />
    )}
    {published && <meta property="article:published_time" content={published} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@700&family=Noto+Serif+SC:wght@400;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
    />

    {structuredJson && <script type="application/ld+json" set:html={structuredJson} />}
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="site-title" href={home}>
          <svg
            class="site-title-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
            <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          </svg>
          {siteTitle}
        </a>
        {alternate && <a class="locale-link" href={alternate.href}>{alternate.label}</a>}
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

const description = 'There is nothing at this address. The link may be out of date or mistyped.';
---

<Base
  title="Page not found"
  description={description}
  locale="en"
  path="/404.html"
  home={withBase('/')}
  alternate={null}
  noindex
>
  <h1>Page not found</h1>
  <p>There is nothing at this address. The link may be out of date or mistyped.</p>
  <p>
    <a href={withBase('/')}>All reports</a>
  </p>
</Base>

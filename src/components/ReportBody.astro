---
/**
 * Renders a report's Markdown, plus a floating table of contents on wide
 * screens built from the report's `h2` headings.
 *
 * Astro processes relative image paths (`img/x.png`) at build time and emits
 * hashed, optimised URLs prefixed with the site's base, so nothing here has to
 * rewrite them. Heading ids come from the generated HTML, so the anchors match
 * the rendered headings while the source stays exactly as written.
 */
import { getEntry, render } from 'astro:content';
import { LOCALES, type Locale } from '../lib/locales';
import { sourceUrlOf } from '../lib/repository';

interface Props {
  id: string;
}

const { id } = Astro.props;
const entry = await getEntry('docs', id);
if (!entry) throw new Error(`Report "${id}" was not found`);

const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);

const locale = entry.data.locale as Locale;
const tocTitle = locale === 'zh-CN' ? '目录' : 'Contents';
const sourceLabel = locale === 'zh-CN' ? '在 GitHub 上查看' : 'View on GitHub';
const sourceUrl = sourceUrlOf(entry.data.sourcePath);
---

<div class="report-layout">
  <div class="report">
    <Content />
  </div>

  {
    sections.length > 0 && (
      <nav class="toc" aria-label={tocTitle}>
        <p class="toc-title">{tocTitle}</p>
        <ul>
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`}>{section.text}</a>
            </li>
          ))}
        </ul>
        <a class="toc-source" href={sourceUrl}>
          <svg
            class="toc-source-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg><span>{sourceLabel}</span>
        </a>
      </nav>
    )
  }
</div>

<script>
  // Marks the section currently in view, and follows in-page jumps to the
  // table of contents.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const idOf = (link: HTMLAnchorElement) => decodeURIComponent(link.hash.slice(1));

  if (links.length > 0) {
    const targets = links
      .map((link) => document.getElementById(idOf(link)))
      .filter((element): element is HTMLElement => element !== null);

    const setActive = (id: string) => {
      for (const link of links) {
        link.classList.toggle('is-active', idOf(link) === id);
      }
    };

    // The section a scroll position belongs to: the last heading whose top has
    // already passed the reading line, so a section keeps its highlight until
    // the next one reaches that line.
    const readingLine = 96;
    const activeAt = (): string | undefined => {
      let current: string | undefined;
      for (const target of targets) {
        if (target.getBoundingClientRect().top <= readingLine) current = target.id;
        else break;
      }
      return current ?? targets[0]?.id;
    };

    let frame = 0;
    const update = () => {
      frame = 0;
      const id = activeAt();
      if (id) setActive(id);
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);

    // A jump inside the page lands the heading exactly at the top edge, which
    // is above the reading line; recompute once the jump has happened.
    addEventListener('hashchange', () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (id) setActive(id);
      schedule();
    });

    update();
  }
</script>
